<Window x:Class="DeepSeek.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="DeepSeek" Height="700" Width="1180"
        MinWidth="800" MinHeight="500"
        WindowStartupLocation="Manual"
        WindowState="Normal"
        AllowDrop="True"
        PreviewDragOver="Window_PreviewDragOver"
        PreviewDrop="Window_PreviewDrop"
        Background="#181C27">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="36"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Top Navigation & Control Bar -->
        <Border Grid.Row="0" Background="#181C27" BorderBrush="#2D3748" BorderThickness="0,0,0,1">
            <DockPanel LastChildFill="False">
                <!-- Left Menu -->
                <Menu DockPanel.Dock="Left" Background="Transparent" Foreground="#E2E8F0" VerticalAlignment="Center">
                    <MenuItem Header="文件(_F)" Padding="8,4">
                        <MenuItem Header="新建会话(_N)" InputGestureText="Ctrl+N" Click="MenuNewChat_Click"/>
                        <Separator/>
                        <MenuItem Header="退出(_X)" InputGestureText="Alt+F4" Click="MenuExit_Click"/>
                    </MenuItem>
                    <MenuItem Header="Agent 闭环(_A)" Padding="8,4">
                        <MenuItem Header="注入大脑协议(_I)" InputGestureText="Ctrl+I" Click="MenuInjectPrompt_Click"/>
                    </MenuItem>
                    <MenuItem Header="视图(_V)" Padding="8,4">
                        <MenuItem Header="刷新(_R)" InputGestureText="Ctrl+R" Click="MenuReload_Click"/>
                        <MenuItem Header="强制刷新" InputGestureText="Ctrl+Shift+R" Click="MenuForceReload_Click"/>
                        <Separator/>
                        <MenuItem Header="放大" InputGestureText="Ctrl++" Click="MenuZoomIn_Click"/>
                        <MenuItem Header="缩小" InputGestureText="Ctrl+-" Click="MenuZoomOut_Click"/>
                        <MenuItem Header="实际大小 (100%)" InputGestureText="Ctrl+0" Click="MenuZoomReset_Click"/>
                        <MenuItem Header="最佳适应 (85%)" Click="MenuZoomFit_Click"/>
                    </MenuItem>
                    <MenuItem Header="帮助(_H)" Padding="8,4">
                        <MenuItem Header="关于 DeepSeek" Click="MenuAbout_Click"/>
                        <MenuItem Header="GitHub 仓库" Click="MenuGitHub_Click"/>
                    </MenuItem>
                </Menu>

                <!-- Right Quick Zoom & Action Bar -->
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
                    <!-- Zoom Controls -->
                    <Border Background="#222736" CornerRadius="4" Padding="2" Margin="0,0,10,0">
                        <StackPanel Orientation="Horizontal">
                            <Button Content=" - " Width="26" Height="24" Click="MenuZoomOut_Click" ToolTip="缩小页面 (Ctrl+-)"
                                    Background="Transparent" Foreground="#E2E8F0" BorderThickness="0" Cursor="Hand" FontWeight="Bold"/>
                            <Button x:Name="btnZoomFactor" Content="85%" Width="48" Height="24" Click="MenuZoomReset_Click" ToolTip="点击重置缩放 (Ctrl+0)"
                                    Background="Transparent" Foreground="#60A5FA" BorderThickness="0" Cursor="Hand" FontSize="11" FontWeight="SemiBold"/>
                            <Button Content=" + " Width="26" Height="24" Click="MenuZoomIn_Click" ToolTip="放大页面 (Ctrl++)"
                                    Background="Transparent" Foreground="#E2E8F0" BorderThickness="0" Cursor="Hand" FontWeight="Bold"/>
                        </StackPanel>
                    </Border>

                    <Button Content="适应 85%" Height="24" Padding="8,0" Click="MenuZoomFit_Click" ToolTip="将缩放调整为 85% 适应屏幕"
                            Background="#222736" Foreground="#94A3B8" BorderThickness="0" Cursor="Hand" FontSize="11" Margin="0,0,8,0"/>

                    <Button Content="注入协议" Height="24" Padding="10,0" Click="MenuInjectPrompt_Click" ToolTip="注入 Agent 大脑系统协议 (Ctrl+I)"
                            Background="#2563EB" Foreground="#FFFFFF" BorderThickness="0" Cursor="Hand" FontSize="11" FontWeight="Medium"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <wv2:WebView2 Grid.Row="1" x:Name="webView" DefaultBackgroundColor="#181C27" AllowDrop="True"/>
    </Grid>
</Window>
