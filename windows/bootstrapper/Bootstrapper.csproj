<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <AssemblyName>DeepSeek-Agent-Bootstrap</AssemblyName>
    <RootNamespace>DeepSeekBootstrap</RootNamespace>
    <Version>1.0.0</Version>
    <Description>DeepSeek Agent portable installer: checks/installs .NET 8 + WebView2, downloads app payload from GitHub release, creates shortcuts, launches.</Description>
    <!-- Console output: pure ASCII-safe text only (legacy cmd.exe has no Emoji glyphs). -->
  </PropertyGroup>

</Project>
