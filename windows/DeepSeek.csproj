<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWPF>true</UseWPF>
    <ApplicationIcon>AppIcon.ico</ApplicationIcon>
    <AssemblyName>DeepSeek</AssemblyName>
    <RootNamespace>DeepSeek</RootNamespace>
    <Version>1.0.7</Version>
    <Authors>moxiuren</Authors>
    <Product>DeepSeek for Windows</Product>
    <Description>Native Windows desktop client for DeepSeek with autonomous local Agent closed-loop execution</Description>
    <!-- 蹇呴』澶氭枃浠跺彂甯冿細Microsoft.PowerShell.SDK 鐨?InitialSessionState.CreateDefault()
         渚濊禆 Assembly.Location 瀹氫綅妯″潡鐩綍锛屽崟鏂囦欢鍙戝竷涓?Location 涓虹┖瀵艰嚧
         "Value cannot be null. (Parameter 'path1')"锛屾墍鏈夊懡浠ら€€鍑虹爜 -1 -->
    <PublishSingleFile>false</PublishSingleFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2903.40" />
    <PackageReference Include="System.Drawing.Common" Version="10.0.12" />
    <PackageReference Include="Microsoft.PowerShell.SDK" Version="7.4.*" />
  </ItemGroup>

  <!-- Nested tool projects (bootstrapper) must NOT be compiled into the app:
       SDK default globs would otherwise pull their sources AND generated obj/*.cs
       into this compilation (duplicate assembly attributes). -->
  <ItemGroup>
    <Compile Remove="bootstrapper\**" />
    <EmbeddedResource Remove="bootstrapper\**" />
    <None Remove="bootstrapper\**" />
    <Content Remove="bootstrapper\**" />
  </ItemGroup>

  <!-- Embed and copy the shared agent_bridge.js from root -->
  <ItemGroup>
    <None Include="..\agent_bridge.js" Link="agent_bridge.js">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <EmbeddedResource Include="..\agent_bridge.js" Link="Resources\agent_bridge.js" />
    <!-- ThreadJob module (Start-ThreadJob backend for Start-Job shim + async lane): ship beside the exe -->
    <None Include="Modules\**" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\api_sniff.js" Link="api_sniff.js">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>

